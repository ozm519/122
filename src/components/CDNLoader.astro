---
// CDNLoader.astro - 本地 vendor 资源加载器
//
// 修复说明：
// - 原版通过 BootCDN/jsDelivr 远程加载 katex/overlayscrollbars/photoswipe，
//   在国内访问不稳定，且部分路径会 404，导致三大功能（数学公式、滚动条美化、图片灯箱）失效。
// - 现改为加载 /public/vendor/ 下的本地资源，彻底消除外网依赖。
//
// 资源路径：
// - /vendor/katex/katex.min.css
// - /vendor/katex/katex.min.js
// - /vendor/katex/auto-render.min.js
// - /vendor/overlayscrollbars/overlayscrollbars.min.css
// - /vendor/overlayscrollbars/overlayscrollbars.esm.js
// - /vendor/photoswipe/photoswipe.css
// - /vendor/photoswipe/photoswipe.esm.min.js
// - /vendor/photoswipe/lightbox/lightbox.esm.min.js

interface Props {
	enableCDN?: boolean;
	useCDNForAll?: boolean;
}

const { enableCDN = true, useCDNForAll = true } = Astro.props;

// 资源清单（统一使用本地路径）
const critical = [
	{ name: "katex", type: "css", path: "/vendor/katex/katex.min.css", priority: "critical" },
	{ name: "katex", type: "js", path: "/vendor/katex/katex.min.js", priority: "critical", globalVar: "katex" },
	{ name: "katex-auto-render", type: "js", path: "/vendor/katex/auto-render.min.js", priority: "critical", globalVar: "renderMathInElement" },
];

const high = [
	{ name: "overlayscrollbars", type: "css", path: "/vendor/overlayscrollbars/overlayscrollbars.min.css", priority: "high" },
	{ name: "overlayscrollbars", type: "js", path: "/vendor/overlayscrollbars/overlayscrollbars.esm.js", priority: "high" },
];

const low = [
	{ name: "photoswipe", type: "css", path: "/vendor/photoswipe/photoswipe.css", priority: "low" },
	{ name: "photoswipe", type: "js", path: "/vendor/photoswipe/photoswipe.esm.min.js", priority: "low" },
	{ name: "photoswipe-lightbox", type: "js", path: "/vendor/photoswipe/lightbox/lightbox.esm.min.js", priority: "low" },
];
---

{enableCDN && (
  <>
    <!-- ==================== Critical Priority (同步加载) ==================== -->
    {critical.map(resource => (
      resource.type === 'css' ? (
        <link
          rel="stylesheet"
          href={resource.path}
          data-vendor-resource={resource.name}
          data-vendor-type={resource.type}
          crossorigin="anonymous"
        />
      ) : null
    ))}

    {critical.filter(r => r.type === 'js').map(resource => (
      <script
        src={resource.path}
        data-vendor-resource={resource.name}
        data-vendor-type={resource.type}
        data-vendor-global-var={resource.globalVar || ''}
        crossorigin="anonymous"
      />
    ))}

    <!-- ==================== High Priority (延迟加载) ==================== -->
    {useCDNForAll && high.map(resource => (
      resource.type === 'css' ? (
        <link
          rel="stylesheet"
          href={resource.path}
          data-vendor-resource={resource.name}
          data-vendor-type={resource.type}
          crossorigin="anonymous"
        />
      ) : null
    ))}

    {useCDNForAll && high.filter(r => r.type === 'js').map(resource => (
      <script
        src={resource.path}
        data-vendor-resource={resource.name}
        data-vendor-type={resource.type}
        defer
        crossorigin="anonymous"
      />
    ))}

    <!-- ==================== Low Priority (懒加载) ==================== -->
    {useCDNForAll && low.map(resource => (
      resource.type === 'css' ? (
        <link
          rel="preload"
          as="style"
          href={resource.path}
          data-vendor-resource={resource.name}
          data-vendor-type={resource.type}
          onload="this.onload=null;this.rel='stylesheet'"
          crossorigin="anonymous"
        />
      ) : null
    ))}
  </>
)}

<!-- 本地 vendor 资源加载状态监控 -->
<script is:inline define:vars={{ enableCDN, useCDNForAll }}>
  window.__VENDOR_STATS__ = {
    totalResources: 0,
    loaded: 0,
    failed: [],
    startTime: Date.now(),
  };

  document.addEventListener('error', function (event) {
    const target = event.target;
    const tagName = target && target.tagName;
    if ((tagName === 'SCRIPT' || tagName === 'LINK') && target.hasAttribute('data-vendor-resource')) {
      const url = target.src || target.href;
      console.error('[Vendor Error]', target.getAttribute('data-vendor-resource'), url);
      window.__VENDOR_STATS__.failed.push({
        resource: target.getAttribute('data-vendor-resource'),
        url,
      });
    }
  }, true);

  window.__VENDOR_STATS__.totalResources = document.querySelectorAll('[data-vendor-resource]').length;
  console.log('[Vendor] 加载本地 vendor 资源，共', window.__VENDOR_STATS__.totalResources, '个');
</script>
