---
import path from "node:path";

interface Props {
id?: string;
src: string;
class?: string;
alt?: string;
position?: string;
basePath?: string;
fit?: string;
lazy?: boolean;
}

import { Image } from "astro:assets";
import { url } from "../../utils/url-utils";

const {
id,
src,
alt,
position = "center",
basePath = "/",
fit = "contain",
lazy = true,
} = Astro.props;
const className = Astro.props.class;

const isLocal = !(
src.startsWith("/") ||
src.startsWith("http") ||
src.startsWith("https") ||
src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img;
if (isLocal) {
const files = import.meta.glob<ImageMetadata>("../../**", {
import: "default",
});
let normalizedPath = path
.normalize(path.join("../../", basePath, src))
.replace(/\\/g, "/");
const file = files[normalizedPath];
if (!file) {
console.error(
`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
);
}
img = await file();
}

// 检测外部是否指定了object-fit，如果没有则使用默认值
const hasCustomFit = className && (className.includes('object-cover') || className.includes('object-contain') || className.includes('object-fill') || className.includes('object-none'));
const finalFit = hasCustomFit ? '' : `object-${fit}`;
const imageClass = `w-full ${finalFit}`.trim();
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    {isLocal && img && <Image src={img} alt={alt || ""} class={imageClass} style={imageStyle} loading={lazy ? "lazy" : "eager"} format="webp" quality={75} />}
    {!isLocal && <img src={isPublic ? url(src) : src} alt={alt || ""} class={imageClass} style={imageStyle} loading={lazy ? "lazy" : "eager"} />}
</div>
