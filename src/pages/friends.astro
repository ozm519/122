---

import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { friendLinkConfig } from "../config";

---

<MainGridLayout title={i18n(I18nKey.friends)} description="友链页面">
    <div class="card-base px-8 py-6">
        <h1 class="text-2xl font-bold mb-6">
            <span class="mr-2 text-blue-600">👥</span>
            {i18n(I18nKey.friends)}
        </h1>
        
        <div class="mb-4">
            <h2 class="text-base font-semibold mb-2">如何加入友链</h2>
            <div class="bg-gray-50 p-2 rounded-lg border border-gray-200">
                <ol class="list-decimal pl-4 space-y-2 mb-2">
                    <li>
                        <strong class="text-sm">第一步：Fork 仓库</strong>
                        <p class="mt-0.5 text-xs text-gray-600">
                            <a href="https://github.com/ozm519/fuwari/fork" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">点击这里</a> 进入 GitHub 仓库页面，然后点击右上角的 "Fork" 按钮，将仓库复制到您自己的 GitHub 账号下。
                        </p>
                    </li>
                    <li>
                        <strong class="text-sm">第二步：修改友链配置</strong>
                        <p class="mt-0.5 text-xs text-gray-600">
                            在您 Fork 的仓库中，找到并打开 <code class="bg-gray-100 px-0.5 py-0.25 rounded text-xs">src/config.ts</code> 文件，然后在 <code class="bg-gray-100 px-0.5 py-0.25 rounded text-xs">friendLinkConfig</code> 配置中添加您的网站信息。
                        </p>
                        <div class="mt-0.5 p-1.5 bg-gray-100 rounded-lg overflow-x-auto">
                            <pre class="text-xs leading-tight"><code>{`// 在 friendLinkConfig.categories 中选择合适的分类，或创建新分类
{
    name: "个人网站", // 分类名称
    links: [
        {
            name: "您的网站名称", // 网站名称
            url: "https://您的网站地址", // 网站完整 URL
            description: "您的网站描述", // 网站简短描述
            avatar: "https://您的头像地址" // 网站头像 URL（可选）
        }
    ]
}`}</code></pre>
                        </div>
                    </li>
                    <li>
                        <strong class="text-sm">第三步：提交更改</strong>
                        <p class="mt-0.5 text-xs text-gray-600">
                            修改完成后，在页面底部填写提交信息（例如："添加友链：您的网站名称"），然后点击 "Commit changes" 按钮提交更改。
                        </p>
                    </li>
                    <li>
                        <strong class="text-sm">第四步：创建 PR 申请</strong>
                        <p class="mt-0.5 text-xs text-gray-600">
                            提交更改后，GitHub 会自动跳转到一个页面，提示您创建 Pull Request。点击 "Compare & pull request" 按钮，然后在新页面中填写 PR 标题和描述，最后点击 "Create pull request" 按钮提交申请。
                        </p>
                    </li>
                </ol>
                <div class="bg-blue-50 p-2 rounded-lg border border-blue-200">
                    <h3 class="font-semibold text-blue-800 mb-0.5 text-xs">注意事项</h3>
                    <ul class="list-disc pl-4 text-xs text-blue-700 space-y-0.5">
                        <li>请确保您的网站可以正常访问</li>
                        <li>请确保您的网站内容健康、积极</li>
                        <li>请提供清晰、准确的网站描述</li>
                        <li>请提供高质量的网站头像</li>
                        <li>如果您的网站无法访问，我们会自动移除您的友链</li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {friendLinkConfig.categories.flatMap(category => category.links).map((link) => (
                <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center p-4 border border-gray-200 rounded-lg hover:border-blue-400 transition-all duration-300"
                >
                    <div class="w-10 h-10 mr-4 rounded-full overflow-hidden flex items-center justify-center flex-shrink-0">
                        {link.avatar ? (
                            <img
                                src={link.avatar}
                                alt={link.name}
                                class="w-full h-full object-cover"
                            />
                        ) : (
                            <div class="w-full h-full bg-gray-100 flex items-center justify-center text-sm font-bold text-gray-500">
                                {link.name.charAt(0)}
                            </div>
                        )}
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="font-bold mb-1 text-base">{link.name}</h3>
                        <p class="text-sm text-gray-500">{link.description}</p>
                    </div>
                </a>
            ))}
        </div>
    </div>
</MainGridLayout>