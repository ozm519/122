---

import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { friendLinkConfig } from "../config";

---

<MainGridLayout title={i18n(I18nKey.friends)} description="友链页面">
    <div class="card-base px-8 py-6">
        <h1 class="text-2xl font-bold mb-6">
            <span class="mr-2 text-blue-600">👥</span>
            {i18n(I18nKey.friends)}
        </h1>
        
        <div class="mb-8">
            <p class="mb-4">如果您也想加入友链名单，请<a href="https://github.com/ozm519/fuwari/issues/new?template=04-friend-link.yml" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">点击这里提交</a></p>
            <p class="text-sm text-gray-500">
                我们会定期通过 Github Action 运行一个工作流，使用 Github 的 IP 对这里的所有站点做访问性测试，
                如果不通过测试（如网站无法访问），该条目将被自动删除。
                当您再次做好准备时，欢迎再次提交申请。
            </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {friendLinkConfig.categories.flatMap(category => category.links).map((link) => (
                <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center p-4 border border-gray-200 rounded-lg hover:border-blue-400 transition-all duration-300"
                >
                    <div class="w-10 h-10 mr-4 rounded-full overflow-hidden flex items-center justify-center flex-shrink-0">
                        {link.avatar ? (
                            <img
                                src={link.avatar}
                                alt={link.name}
                                class="w-full h-full object-cover"
                            />
                        ) : (
                            <div class="w-full h-full bg-gray-100 flex items-center justify-center text-sm font-bold text-gray-500">
                                {link.name.charAt(0)}
                            </div>
                        )}
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="font-bold mb-1 text-base">{link.name}</h3>
                        <p class="text-sm text-gray-500">{link.description}</p>
                    </div>
                </a>
            ))}
        </div>
    </div>
</MainGridLayout>